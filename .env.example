# notifications-and-alerts — every setting, with its default. Copy to .env, or map
# them from your module's own settings into NotifySettings(...).

# smtp | graph | console | memory
NOTIFY_EMAIL_TRANSPORT=console
NOTIFY_FROM_ADDRESS=no-reply@example.com
NOTIFY_FROM_NAME=AIPMS

# SMTP (Office 365: smtp.office365.com:587 with STARTTLS)
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_STARTTLS=true
NOTIFY_SMTP_USE_SSL=false

# Microsoft Graph, app-only (Mail.Send application permission)
NOTIFY_GRAPH_TENANT_ID=
NOTIFY_GRAPH_CLIENT_ID=
NOTIFY_GRAPH_CLIENT_SECRET=
NOTIFY_GRAPH_SENDER=

# Storage — or pass your module's engine to Notifier.from_settings(engine=…)
NOTIFY_DATABASE_URL=
NOTIFY_DB_SCHEMA=
NOTIFY_TABLE_PREFIX=notify_

# Reminders
NOTIFY_TIMEZONE=Asia/Kolkata
NOTIFY_WORKER_INTERVAL_SECONDS=30
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_RETRY_BACKOFF_MINUTES=[5,15,60]

# Limits
NOTIFY_MAX_ATTACHMENT_MB=20
NOTIFY_MAX_TOTAL_ATTACHMENTS_MB=25
NOTIFY_MAX_RECIPIENTS=100
