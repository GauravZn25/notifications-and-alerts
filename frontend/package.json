{
  "name": "@rodichub/notifications-and-alerts",
  "version": "0.1.0",
  "description": "In-app notifications for AIPMS apps: the bell's count (for the shell TopBar), a drawer, and live toasts — talking to the notifications_and_alerts FastAPI router.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "src"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "~6.0.2"
  }
}
